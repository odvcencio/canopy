+	// qualified namespace names as module definitions without disturbing any
+	// existing captures.
+	"c_sharp": strings.Join([]string{
+		"(namespace_declaration name: [(identifier) (qualified_name)] @name) @definition.module",
+	}, "\n"),
 }
 
