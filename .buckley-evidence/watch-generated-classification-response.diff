diff --git a/pkg/index/watch_incremental_test.go b/pkg/index/watch_incremental_test.go
index 0000000..0000002 100644
--- a/pkg/index/watch_incremental_test.go
+++ b/pkg/index/watch_incremental_test.go
@@ import (
 	"context"
+	"fmt"
 	"os"
 	"path/filepath"
 	"testing"
 	"time"
+
+	"m31labs.dev/canopy/pkg/generated"
 )
+
+func TestApplyWatchChanges_SubfileIncremental_PreservesGeneratedClassification(t *testing.T) {
+	root := t.TempDir()
+	path := filepath.Join(root, "api.pb.go")
+	source := "// Code generated by protoc. DO NOT EDIT.\npackage sample\n\nfunc Generated() {}\n"
+	if err := os.WriteFile(path, []byte(source), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	builder := NewBuilder()
+	builder.SetDetector(generated.NewDetector(nil))
+
+	idx, err := builder.BuildPathIncremental(context.Background(), root)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := idx.GeneratedFileCount(); got != 1 {
+		t.Fatalf("initial generated file count = %d, want 1", got)
+	}
+
+	state := NewWatchState()
+	defer state.Release()
+
+	updated := source + "\nfunc AnotherGenerated() { fmt.Println(\"x\") }\n"
+	if err := os.WriteFile(path, []byte(updated), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	stats, err := builder.ApplyWatchChanges(idx, state, root, []string{"api.pb.go"}, WatchUpdateOptions{SubfileIncremental: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if stats.ParsedFiles != 1 {
+		t.Fatalf("stats.ParsedFiles = %d, want 1", stats.ParsedFiles)
+	}
+
+	file := idx.Files()["api.pb.go"]
+	if file == nil {
+		t.Fatal("updated file missing from index")
+	}
+	if file.Generated == nil {
+		t.Fatal("updated generated file count = 0, want 1")
+	}
+	if file.Generated.Generator == "" || file.Generated.Reason == "" {
+		t.Fatalf("generated metadata not meaningful: %+v", file.Generated)
+	}
+
+	filtered := idx.WithoutGenerated()
+	if _, ok := filtered.Files()["api.pb.go"]; ok {
+		t.Fatal("WithoutGenerated did not exclude updated generated file")
+	}
+}