+// supplementalTagsQueries holds extra query patterns appended to the resolved
+// base query for languages whose curated queries miss common definitions.
+var supplementalTagsQueries = map[string]string{
+	"typescript": strings.Join([]string{
+		"(variable_declarator name: (identifier) @name value: (arrow_function)) @definition.function",
+	}, "\n"),
+}
+
 // ResolveTagsQuery returns the tree-sitter tags query canopy should use for a
 // language entry, in priority order:
 //
@@ -74,10 +81,17 @@ func ResolveTagsQuery(entry grammars.LangEntry) string {
 // It returns "" when none of the above yields a query.
 func ResolveTagsQuery(entry grammars.LangEntry) string {
 	if q := strings.TrimSpace(entry.TagsQuery); q != "" {
 		return entry.TagsQuery
 	}
-	if q := curatedTagsQueries[entry.Name]; strings.TrimSpace(q) != "" {
-		return q
+
+	base := curatedTagsQueries[entry.Name]
+	if strings.TrimSpace(base) == "" {
+		base = grammars.ResolveTagsQuery(entry)
+	}
+
+	supplemental := supplementalTagsQueries[entry.Name]
+	if strings.TrimSpace(base) == "" || strings.TrimSpace(supplemental) == "" {
+		return base
 	}
-	return grammars.ResolveTagsQuery(entry)
+
+	return base + "\n" + supplemental
 }
diff --git a/pkg/lang/treesitter/typescript_tags_test.go b/pkg/lang/treesitter/typescript_tags_test.go
new file mode 100644
index 0000000..3333333
--- /dev/null
+++ b/pkg/lang/treesitter/typescript_tags_test.go
@@ -0,0 +1,45 @@
+package treesitter
+
+import (
+	"testing"
+
+	"canopy/pkg/lang/grammars"
+	"canopy/pkg/model"
+)
+
+const typescriptArrowSample = `export const fetchUser = async (id: string): Promise<string> => {
+  return normalize(id)
+}
+
+function normalize(value: string): string {
+  return value.trim()
+}
+
+fetchUser("42")
+`
+
+func TestResolveTagsQueryTypeScriptArrowFunctions(t *testing.T) {
+	entry := findEntryByExtension(t, ".ts")
+	query := ResolveTagsQuery(entry)
+	if query == "" {
+		t.Fatal("ResolveTagsQuery returned empty query for TypeScript")
+	}
+	if !contains(query, "arrow_function") {
+		t.Fatalf("query missing arrow_function pattern: %q", query)
+	}
+}
+
+func TestParseTypeScriptArrowFunctionTags(t *testing.T) {
+	entry := findEntryByExtension(t, ".ts")
+	parser, err := NewParser(entry)
+	if err != nil {
+		t.Fatalf("NewParser: %v", err)
+	}
+	summary, err := parser.Parse("sample.ts", []byte(typescriptArrowSample))
+	if err != nil {
+		t.Fatalf("Parse: %v", err)
+	}
+	if !hasSymbol(summary, "function_definition", "fetchUser") {
+		t.Error("missing function_definition symbol fetchUser")
+	}
+	if !hasSymbol(summary, "function_definition", "normalize") {
+		t.Error("missing function_definition symbol normalize")
+	}
+	if !hasReference(summary, "call", "normalize") {
+		t.Error("missing call reference to normalize")
+	}
+	if !hasReference(summary, "call", "fetchUser") {
+		t.Error("missing call reference to fetchUser")
+	}
+}
