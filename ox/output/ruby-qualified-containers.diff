+
+const rubyQualifiedSample = "class Billing::Invoice\nend\nmodule API::V2\nend\n"
+
+func TestRubyQualifiedContainerExtraction(t *testing.T) {
+	entry := findEntryByExtension(t, ".rb")
+	parser, err := NewParser(entry)
+	if err != nil {
+		t.Fatalf("NewParser: %v", err)
+	}
+	summary, err := parser.Parse("qualified.rb", []byte(rubyQualifiedSample))
+	if err != nil {
+		t.Fatalf("Parse: %v", err)
+	}
+	if !hasSymbol(summary, "class_definition", "Invoice") {
+		t.Errorf("missing qualified class definition Invoice")
+	}
+	if !hasSymbol(summary, "module_definition", "V2") {
+		t.Errorf("missing qualified module definition V2")
+	}
+}